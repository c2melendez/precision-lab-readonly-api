# Create a fine-grained GitHub token restricted to the two Precision Lab repositories.
# Required repository permissions: Contents: read, Actions: read, Metadata: read.
GITHUB_READ_TOKEN=

# Server-side token for the authenticated Bridge operation routes.
# Restrict it to Lite/Plus; grant Contents: write, Pull requests: write,
# Actions: write, Workflows: write, and the standard Metadata: read.
# Never expose this token to a GPT Action or include it in prompts.
GITHUB_WRITE_TOKEN=

# Generate a separate API key for GPT Actions; never reuse the GitHub token.
SERVICE_API_KEY=

# Optional: after Render assigns a public hostname, set it here and redeploy so the
# generated OpenAPI document advertises the correct server URL.
PUBLIC_BASE_URL=

GITHUB_TIMEOUT_SECONDS=15
